# Copy this file to .env and fill in what you need. The default stack
# (docker compose up) needs NO keys at all: it runs on a local mock model.
# Never commit .env.

# Real AI model, optional (docker compose -f docker-compose.yml -f docker-compose.real.yml up -d).
# Any one of these is enough.
GROQ_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=

# Tavily, optional: live web-page evidence for the freshness check
# (switch the companion to -provider=tavily_extract, see DOCKER.md).
TAVILY_API_KEY=
